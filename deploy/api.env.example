POWER_MONITOR_TOKEN=replace-with-a-long-random-token
POWER_MONITOR_HOST=127.0.0.1
POWER_MONITOR_PORT=8090
POWER_MONITOR_DATABASE=/var/lib/iotmonitor/power-monitor.db
POWER_MONITOR_RAW_ARCHIVE=/var/lib/iotmonitor/dlt645-frames.jsonl
POWER_MONITOR_LOG_ONLY=false
# Production: use the Monitor Center PostgreSQL database instead of local SQLite.
# POWER_MONITOR_CENTER_DATABASE_URL=postgresql://monitor_center:<password>@10.77.0.1:5432/monitor_center
# When the device ingress and dashboard/API are on different hosts, forward the
# validated frame batch to the dashboard/API host as well.
# POWER_MONITOR_RAW_FORWARD_URL=https://iot.ohmyskills.top/api/v1/dlt645/frame
